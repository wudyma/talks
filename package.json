{
  "name": "zheng-talks",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun run scripts/build-all.ts",
    "dev": "bun scripts/picker.ts dev --open",
    "metadata": "bun run scripts/collect-metadata.ts",
    "metadata:check": "bun run scripts/collect-metadata.ts --check",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "update": "bun scripts/redirects.ts"
  },
  "workspaces": {
    "packages": [
      "talks/*"
    ],
    "catalog": {
      "@slidev/cli": "52.19.1",
      "@slidev/client": "52.19.1",
      "@slidev/theme-default": "^0.25.0",
      "unocss": "^66.12.0",
      "vite": "^8.3.5",
      "vue": "^3.5.44"
    }
  },
  "devDependencies": {
    "@slidev/client": "catalog:",
    "@unocss/preset-web-fonts": "^66.12.0",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/seedrandom": "^3.0.8",
    "esbuild": "^0.28.2",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "find-up": "^8.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.90.0",
    "playwright-chromium": "^1.64.1",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "seedrandom": "^3.0.5",
    "tinyexec": "^1.3.1",
    "unocss": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "^3.3.14"
  }
}
